<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ============================== -->
    <!-- Advertisement - Keyboard-এর উপরে -->
    <!-- ============================== -->

    <com.google.android.gms.ads.AdView
        android:id="@+id/banglish_ad_view"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_gravity="center"

        ads:adSize="BANNER"
        ads:adUnitId="ca-app-pub-3940256099942544/6300978111" />

    <!-- ============================== -->
    <!-- Voice Input Button -->
    <!-- ============================== -->

    <Button
        android:id="@+id/bangla_voice_button"
        android:layout_width="match_parent"
        android:layout_height="40dp"

        android:text="🎤  ভয়েস দিয়ে লিখুন"
        android:textSize="14sp"
        android:textColor="#000000"

        android:background="#EEEEEE"

        android:padding="0dp"
        android:minHeight="0dp"
        android:minWidth="0dp" />

    <!-- ============================== -->
    <!-- বাংলা Keyboard -->
    <!-- ============================== -->

    <android.inputmethodservice.KeyboardView
        android:id="@+id/bangla_keyboard_view"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:background="#FFFFFF"

        android:keyBackground="@drawable/keyboard_key_background"

        android:keyTextColor="#000000"
        android:keyTextSize="20sp"

        android:focusable="true"
        android:focusableInTouchMode="true"

        android:padding="0dp" />

</LinearLayout>
