<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFF8F4">

    <LinearLayout
        android:id="@+id/bangla_toolbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:background="#FFF8F4">

        <Button
            android:id="@+id/bangla_menu_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="&#8862;"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:textColor="#888888"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/bangla_emoji_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="&#128512;"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:textColor="#888888"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/bangla_clipboard_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="&#128203;"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:textColor="#888888"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/bangla_gif_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="GIF"
            android:textSize="11sp"
            android:background="@android:color/transparent"
            android:textColor="#888888"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/bangla_settings_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="&#9881;"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:textColor="#888888"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

        <Button
            android:id="@+id/bangla_voice_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="&#127908;"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:textColor="#888888"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp" />

    </LinearLayout>

    <android.inputmethodservice.KeyboardView
        android:id="@+id/bangla_keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:background="#FFF8F4"
        android:keyBackground="@drawable/keyboard_key_background"
        android:keyTextColor="#333333"
        android:keyTextSize="18sp"
        android:shadowRadius="0"
        android:shadowColor="@null" />

    <LinearLayout
        android:id="@+id/bangla_emoji_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#FFF8F4"
        android:padding="4dp" />

    <FrameLayout
        android:id="@+id/startio_banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone" />

</FrameLayout>
