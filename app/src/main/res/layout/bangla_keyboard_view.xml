<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bangla_keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#EAF5E4">

    <!-- Top Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:background="#FFF1F2"
        android:gravity="center"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <!-- Copy/Paste -->
        <TextView
            android:id="@+id/btn_copy_paste"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="📋  কপি/পেস্ট"
            android:textColor="#111111"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:background="#D1D5DB" />

        <!-- Voice -->
        <TextView
            android:id="@+id/btn_voice_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:text="🎙  ভয়েস ইনপুট"
            android:textColor="#111111"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Start.io Banner: বাংলা Keyboard-এর জন্য -->
    <FrameLayout
        android:id="@+id/startio_banner_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Keyboard View -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EAF5E4"
        android:keyBackground="@drawable/keyboard_key_background"
        android:keyTextColor="#111111"
        android:keyTextSize="18sp"
        android:labelTextSize="13sp"
        android:paddingLeft="3dp"
        android:paddingRight="3dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:shadowColor="#00000000"
        android:shadowRadius="0" />

</LinearLayout>
