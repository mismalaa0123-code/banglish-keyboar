<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E2E5E9">

    <!-- ১. প্রিভিউ এবং কনভার্ট বাটন বার -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/preview_text_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="এখানে বাংলা দেখা যাবে..."
            android:textColor="#333333"
            android:textSize="16sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btn_mic"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="🎤"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FF9800"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_convert"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:text="Convert"
            android:textColor="#FFFFFF"
            android:backgroundTint="#008577"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ২. মূল কিবোর্ড ভিউ (হালকা ১২dp দূরত্ব রাখা হয়েছে) -->
    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#E2E5E9"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:keyBackground="@drawable/keyboard_key_background"
        android:keyTextColor="#202124"
        android:keyTextSize="20sp"
        android:shadowColor="#00000000"
        android:shadowRadius="0" />

</LinearLayout>
