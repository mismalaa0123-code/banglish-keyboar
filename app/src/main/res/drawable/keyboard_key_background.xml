<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Key চাপলে -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#DCE8F7" />
            <stroke
                android:width="1dp"
                android:color="#AFC7E8" />
            <corners android:radius="9dp" />
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp" />
        </shape>
    </item>

    <!-- Normal key -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#D9E2D4" />
            <corners android:radius="9dp" />
            <padding
                android:left="1dp"
                android:top="1dp"
                android:right="1dp"
                android:bottom="1dp" />
        </shape>
    </item>

</selector>
