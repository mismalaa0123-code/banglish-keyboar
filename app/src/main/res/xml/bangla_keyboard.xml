<!-- বাকি উপরের সব Row আগের মতই থাকবে, শুধু নিচের Row-টি এভাবে আপডেট করুন -->
    <Row android:keyHeight="50dp">
        <!-- '?' এর বদলে অন্য চিহ্ন বা Unicode ব্যবহার করা হলো এরর এড়াতে -->
        <Key android:codes="-2" android:keyLabel="123" android:keyWidth="15%p"/>
        <Key android:codes="-100" android:keyLabel="😊" android:keyWidth="10%p"/>
        <Key android:codes="-101" android:keyIcon="@android:drawable/ic_dialog_map" android:keyWidth="10%p"/>
        <Key android:codes="32" android:keyLabel="বাংলা" android:keyWidth="35%p" android:isRepeatable="true"/>
        <Key android:codes="-102" android:keyLabel="⇳" android:keyWidth="10%p"/>
        <Key android:codes="2404" android:keyLabel="।" android:keyWidth="10%p"/>
        <Key android:codes="10" android:keyLabel="⏎" android:keyWidth="10%p"/>
    </Row>
