            android:keyWidth="10%p" />

    </Row>


    <!-- ================================================= -->
    <!-- BOTTOM FUNCTION ROW                                -->
    <!-- ================================================= -->

    <Row android:keyHeight="50dp">

        <!-- Number / Symbol -->
        <Key
            android:codes="-2"
            android:keyLabel="?১২৩"
            android:keyWidth="15%p" />

        <!-- Emoji -->
        <Key
            android:codes="-100"
            android:keyLabel="😊"
            android:keyWidth="10%p" />

        <!-- Globe / Language -->
        <Key
            android:codes="-101"
            android:keyIcon="@android:drawable/ic_menu_set_as"
            android:keyWidth="10%p" />

        <!-- Space -->
        <Key
            android:codes="32"
            android:keyLabel="বাংলা"
            android:keyWidth="35%p"
            android:isRepeatable="true" />

        <!-- Cursor Control -->
        <Key
            android:codes="-102"
            android:keyLabel="⇳"
            android:keyWidth="10%p" />

        <!-- Punctuation -->
        <Key
            android:codes="124"
            android:keyLabel="।"
            android:keyWidth="10%p" />

        <!-- Enter -->
        <Key
            android:codes="10"
            android:keyLabel="⏎"
            android:keyWidth="10%p" />

    </Row>

