<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ============================================== -->
    <!-- Network Permissions -->
    <!-- ============================================== -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 12+ Advertising ID -->
    <uses-permission android:name="android.permission.AD_ID" />

    <!-- ============================================== -->
    <!-- Voice Input -->
    <!-- ============================================== -->

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:label="Arafatakaid Banglish Keyboard"
        android:icon="@drawable/banglish_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat">

        <!-- ============================================== -->
        <!-- Start.io App ID -->
        <!-- ============================================== -->

        <meta-data
            android:name="com.startapp.sdk.APPLICATION_ID"
            android:value="207212666" />

        <!-- ============================================== -->
        <!-- Main App -->
        <!-- ============================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- ============================================== -->
        <!-- Banglish Keyboard -->
        <!-- ============================================== -->

        <service
            android:name=".BanglishIME"
            android:exported="true"
            android:label="Banglish Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">

            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />

        </service>

        <!-- ============================================== -->
        <!-- English Keyboard -->
        <!-- ============================================== -->

        <service
            android:name=".EnglishIME"
            android:exported="true"
            android:label="English Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">

            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method_english" />

        </service>

        <!-- ============================================== -->
        <!-- Bangla Keyboard -->
        <!-- ============================================== -->

        <service
            android:name=".BanglaIME"
            android:exported="true"
            android:label="বাংলা Keyboard"
            android:permission="android.permission.BIND_INPUT_METHOD">

            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>

            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method_bangla" />

        </service>

    </application>

</manifest>
